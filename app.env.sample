# Couchbase environment configuration

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Admin credentials
DB_ADMIN_NAME=admin
DB_ADMIN_PASS=changeme_admin_password

# Default bucket
DB_CREATE_DATABASE_NAME=default
COUCHBASE_BUCKET_RAMSIZE=1024
